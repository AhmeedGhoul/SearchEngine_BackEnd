# YouTube Data API v3 Key
# Get it from: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# mediaEngine REST API Configuration
MEDIAENGINE_API_URL=http://127.0.0.1:8090/api/v1.1
MEDIAENGINE_USERNAME=admin
MEDIAENGINE_PASSWORD=admin

# mediaEngine SDK path — set as a Windows system environment variable instead of here
# Control Panel > System > Advanced > Environment Variables > MEDIAENGINE_SDK_PATH
